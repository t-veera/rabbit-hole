# --- Database (matches docker-compose.yml Postgres service) ---
DATABASE_URL=postgresql+psycopg://rabbithole:rabbithole@localhost:5433/rabbithole

# --- Anthropic API key, used to translate plain-language interests into ---
# --- real academic search terms. Without it, translation falls back to  ---
# --- a naive passthrough (app still runs, just dumber search terms).    ---
ANTHROPIC_API_KEY=

# --- Required by Unpaywall's usage terms. MUST be a real address — ---
# --- Unpaywall's API hard-rejects "you@example.com" (422 error) and ---
# --- every open-access lookup silently fails until this is real.    ---
UNPAYWALL_EMAIL=you@example.com

# --- Optional: gets OpenAlex's faster "polite pool". Any email works. ---
OPENALEX_MAILTO=you@example.com

# --- Optional: raises PubMed E-utilities rate limit from 3req/s to 10req/s ---
NCBI_API_KEY=

# --- Optional: raises Semantic Scholar rate limits ---
SEMANTIC_SCHOLAR_API_KEY=

# --- Optional but valuable: free key from https://core.ac.uk/services/api ---
# --- CORE aggregates institutional-repository copies that Unpaywall/OpenAlex ---
# --- sometimes miss (an author's own university mirror, for instance) — the ---
# --- last fallback when a publisher's OA copy is bot-walled and no other   ---
# --- indexed copy exists. Without this key, that specific case just stays  ---
# --- unresolved (everything else about full-text fetching still works).   ---
CORE_API_KEY=

# --- CORS: comma-separated origins allowed to call the API ---
CORS_ORIGINS=http://localhost:5173
